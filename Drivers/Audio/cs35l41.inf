;
; cs35l41.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Media
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = cs35l41.cat
DriverVer = 11/09/2026,19.15.15.331
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
cs35l41.sys  = 1,,

;13 == Windows\System32\DriverStore
[DestinationDirs]
DefaultDestDir = 13

;*****************************************
; cs35l41 Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = CS35L41, NTARM64.10.0...16299


[CS35L41.NTARM64.10.0...16299]
%cs35l41.DeviceDesc% = cs35l41_Device, ACPI\CS35L41

[cs35l41_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
cs35l41.sys

;-------------- Service installation
[cs35l41_Device.NT.Services]
AddService = cs35l41,%SPSVCINST_ASSOCSERVICE%, cs35l41_Service_Inst

; -------------- cs35l41 driver install sections
[cs35l41_Service_Inst]
DisplayName    = %cs35l41.SVCDESC%
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_DEMAND_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
ServiceBinary  = %13%\cs35l41.sys
LoadOrderGroup = Base

[Strings]
ManufacturerName   = "map220v"
DiskName           = "CS35L41 Installation Disk"
cs35l41.DeviceDesc = "Cirrus Logic CS35L41 Codec"
cs35l41.SVCDESC    = "CS35L41 Service"

;Non-Localizable Strings
SPSVCINST_ASSOCSERVICE = 0x00000002
SERVICE_KERNEL_DRIVER  = 1
SERVICE_DEMAND_START   = 3
SERVICE_ERROR_NORMAL   = 1
